def main():
    prog = os.path.basename(sys.argv[0])
    
    inferred_cluster = None
    if prog.endswith("-run") and prog != "hpc-run":
        name_part = prog[:-4].lower()
        if name_part in CLUSTERS:
            inferred_cluster = name_part
        elif name_part in CLUSTER_ALIASES:
            inferred_cluster = CLUSTER_ALIASES[name_part]
        elif name_part == "gaea":
            inferred_cluster = "gaea"

    args = sys.argv[1:]
    if not args and not inferred_cluster:
        print_help()
        sys.exit(0)

    # Global flags
    if args and args[0] in ["--help", "-h"]:
        print_help()
        sys.exit(0)

    if args and args[0] == "--list":
        print_help()
        sys.exit(0)

    if args and args[0] == "--status":
        raw_target = args[1].lower() if len(args) > 1 else (inferred_cluster or "all")
        if raw_target == "all":
            for c, info in CLUSTERS.items():
                _, status = check_status(c)
                print(f"{c:<10}: {status}")
        elif raw_target == "gaea":
            for c in GAEA_CLUSTERS:
                _, status = check_status(c)
                print(f"{c:<10}: {status}")
        else:
            target = CLUSTER_ALIASES.get(raw_target, raw_target)
            if target not in CLUSTERS:
                print(f"Unknown cluster: {raw_target}. Available: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}")
                sys.exit(1)
            _, status = check_status(target)
            print(f"{target}: {status}")
        sys.exit(0)

    if args and args[0] == "--cancel":
        raw_target = args[1].lower() if len(args) > 1 else inferred_cluster
        if not raw_target or raw_target == "all":
            print("Please specify a cluster to cancel (e.g. hpc-run --cancel gaea-c6)")
            sys.exit(1)
        if raw_target == "gaea":
            for c in GAEA_CLUSTERS:
                cancel_command(c)
        else:
            target = CLUSTER_ALIASES.get(raw_target, raw_target)
            if target not in CLUSTERS:
                print(f"Unknown cluster: {raw_target}. Available: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}")
                sys.exit(1)
            cancel_command(target)
        sys.exit(0)

    if args and args[0] == "--start":
        raw_target = args[1].lower() if len(args) > 1 else inferred_cluster
        if not raw_target or raw_target == "all":
            print("Please specify a cluster to start (e.g. hpc-run --start gaea-c6)")
            print(f"Available: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}")
            sys.exit(1)
        if raw_target == "gaea":
            target = "gaea-c5"
            print("[GAEA] Generic 'gaea' defaults to gaea-c5. (Use --start gaea-c6 or gaea-c7 for C6/C7).")
        else:
            target = CLUSTER_ALIASES.get(raw_target, raw_target)
        if target not in CLUSTERS:
            print(f"Unknown cluster: {raw_target}. Available: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}")
            sys.exit(1)
        start_daemon_interactive(target)
        sys.exit(0)

    if args and args[0] == "--stop":
        raw_target = args[1].lower() if len(args) > 1 else (inferred_cluster or "all")
        if raw_target == "all":
            for c in CLUSTERS:
                stop_daemon(c)
            if os.path.exists(os.path.expanduser("~/.ssh/hpc_gaea.pid")):
                stop_daemon("gaea")
        elif raw_target == "gaea":
            for c in GAEA_CLUSTERS:
                stop_daemon(c)
            if os.path.exists(os.path.expanduser("~/.ssh/hpc_gaea.pid")):
                stop_daemon("gaea")
        else:
            target = CLUSTER_ALIASES.get(raw_target, raw_target)
            if target not in CLUSTERS:
                print(f"Unknown cluster: {raw_target}. Available: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}")
                sys.exit(1)
            stop_daemon(target)
        sys.exit(0)

    # Command execution
    cluster = inferred_cluster
    target_node = None
    is_async = False

    if not cluster:
        cand = args[0].lower()
        if cand in CLUSTERS:
            cluster = cand
            cmd_args = args[1:]
        elif cand in CLUSTER_ALIASES:
            cluster = CLUSTER_ALIASES[cand]
            cmd_args = args[1:]
        elif cand == "gaea":
            cluster = "gaea"
            cmd_args = args[1:]
        else:
            print(f"Error: Unknown cluster '{cand}'.")
            all_options = list(CLUSTERS.keys()) + ["c5", "c6", "c7", "gaea"]
            print(f"Available clusters/targets: {', '.join(all_options)}")
            print("Run 'hpc-run --help' for usage.")
            sys.exit(1)
    else:
        cmd_args = list(args)

    # Parse Gaea-specific flags and --async from cmd_args
    filtered_cmd_args = []
    i = 0
    while i < len(cmd_args):
        arg = cmd_args[i]
        if arg == "--async":
            is_async = True
            i += 1
        elif (cluster == "gaea" or cluster in GAEA_CLUSTERS) and arg in ("--c5", "-5", "-c5"):
            cluster = "gaea-c5"
            i += 1
        elif (cluster == "gaea" or cluster in GAEA_CLUSTERS) and arg in ("--c6", "-6", "-c6"):
            cluster = "gaea-c6"
            i += 1
        elif (cluster == "gaea" or cluster in GAEA_CLUSTERS) and arg in ("--c7", "-7", "-c7"):
            cluster = "gaea-c7"
            i += 1
        elif (cluster == "gaea" or cluster in GAEA_CLUSTERS) and arg in ("--node", "-n"):
            if i + 1 < len(cmd_args):
                target_node = cmd_args[i + 1]
                i += 2
            else:
                print("Error: --node requires a hostname argument (e.g. --node gaea62)")
                sys.exit(1)
        elif (cluster == "gaea" or cluster in GAEA_CLUSTERS) and arg.startswith("--node="):
            target_node = arg.split("=", 1)[1]
            i += 1
        else:
            filtered_cmd_args.append(arg)
            i += 1

    # Auto-resolve target node to appropriate Gaea sub-cluster if specified
    if target_node:
        t_node = target_node.strip()
        if t_node.startswith("gaea5"):
            cluster = "gaea-c5"
        elif t_node.startswith("gaea6"):
            cluster = "gaea-c6"
        elif t_node.startswith("gaea7"):
            cluster = "gaea-c7"

    # If cluster is still generic 'gaea', resolve to active or default Gaea cluster
    if cluster == "gaea":
        cluster = resolve_default_gaea_cluster()

    if cluster in CLUSTER_ALIASES:
        cluster = CLUSTER_ALIASES[cluster]

    cmd = " ".join(filtered_cmd_args)
    if not cmd.strip():
        print(f"Error: No command specified for cluster '{cluster}'.")
        sys.exit(1)

    # Apply node or C7 routing if applicable
    if cluster in GAEA_CLUSTERS:
        cmd = route_gaea_command(cluster, cmd, target_node=target_node)

    # Auto-start daemon if not running
    ok = ensure_daemon_running(cluster)
    if not ok:
        sys.exit(1)

    # Format wire request
    wire_cmd = f"__ASYNC__ {cmd}" if is_async else cmd
    code, out = client_send(cluster, wire_cmd)

    if code is None:
        print(f"Error communicating with {cluster}: {out}", file=sys.stderr)
        sys.exit(1)

    sys.stdout.write(out)
    if not out.endswith('\n'):
        sys.stdout.write('\n')
    sys.exit(code)

if __name__ == '__main__':
    main()
