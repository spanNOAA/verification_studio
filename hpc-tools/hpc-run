def get_paths(cluster):
    """
    Returns paths for socket, pid, and log files.
    P1-5: Uses 'hpc_ro_{cluster}' socket namespace to isolate from legacy daemons.
    Enforces 0700 permissions on base directory.
    """
    base_dir = os.path.expanduser("~/.ssh")
    try:
        os.makedirs(base_dir, mode=0o700, exist_ok=True)
        os.chmod(base_dir, 0o700)
    except Exception:
        pass

    sock = os.path.join(base_dir, f"hpc_ro_{cluster}.sock")
    pid_f = os.path.join(base_dir, f"hpc_ro_{cluster}.pid")
    log_f = os.path.join(base_dir, f"hpc_ro_{cluster}.log")
    return sock, pid_f, log_f


def check_legacy_daemon(cluster):
    """
    P1-5: Detects if a legacy, non-read-only daemon is currently running.
    Does NOT blindly execute SIGKILL; outputs a notice advising safe migration.
    """
    legacy_sock = os.path.expanduser(f"~/.ssh/hpc_{cluster}.sock")
    legacy_pid = os.path.expanduser(f"~/.ssh/hpc_{cluster}.pid")

    if os.path.exists(legacy_pid):
        try:
            with open(legacy_pid, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            sys.stderr.write(
                f"\n[SECURITY NOTICE] Legacy daemon detected running on [{cluster.upper()}] (PID={pid}, socket={legacy_sock}).\n"
                f"To maintain isolated read-only security, please stop the legacy daemon before starting read-only mode.\n"
                f"You can stop it via: kill {pid} && rm -f {legacy_sock} {legacy_pid}\n\n"
            )
            return True
        except (OSError, ValueError):
            pass
    return False


def verify_peer_uid(conn):
    """
    P1-5: Verifies that the connected socket client process matches current user UID.
    """
    try:
        if hasattr(socket, "SO_PEERCRED"):
            creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
            _, uid, _ = struct.unpack("3i", creds)
            return uid == os.getuid()
        elif sys.platform == "darwin":
            # Darwin LOCAL_PEERCRED (SOL_LOCAL = 0, LOCAL_PEERCRED = 0x001)
            creds = conn.getsockopt(0, 0x001, 16)
            _, uid = struct.unpack("II", creds[:8])
            return uid == os.getuid()
    except Exception:
        pass
    # If peer credential inspection is unsupported by kernel/runtime, rely on POSIX 0600 socket mode
    return True


class HPCDaemon:
    """
    Hardened Read-Only HPC Daemon (V1).
    Maintains persistent PTY connection and strictly executes structured read-only operations.
    """
    def __init__(self, cluster, master_fd=None, child_pid=None):
        self.cluster = cluster
        self.cfg = CLUSTERS[cluster]
        self.sock_path, self.pid_path, self.log_path = get_paths(cluster)
        self.master = master_fd
        self.proc_pid = child_pid
        self.running = True
        self.log_fp = None
        self.cmd_lock = threading.Lock()
        self.current_cmd = None
        self.current_cmd_start = 0.0

    def log(self, msg):
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        line = f"[{ts}] [{self.cluster.upper()}] {msg}\n"
        if self.log_fp:
            try:
                self.log_fp.write(line)
                self.log_fp.flush()
            except Exception:
                pass

    def start_ssh_session_headless(self):
        ssh_cmd = get_ssh_cmd(self.cluster)
        child_pid, master_fd = pty.fork()
        if child_pid == 0:
            os.execvp('ssh', ssh_cmd)

        self.master = master_fd
        self.proc_pid = child_pid

        buf = b''
        start_time = time.time()
        timeout = self.cfg["timeout_init"]
        prompt_re = self.cfg["prompt_regex"]
        ansi_cleaner = re.compile(r'\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])|\x1b\][^\x07\x1b]*[\x07\x1b\\]')

        while time.time() - start_time < timeout:
            r, _, _ = select.select([self.master], [], [], 0.5)
            if self.master in r:
                try:
                    chunk = os.read(self.master, 4096)
                    if not chunk:
                        break
                    buf += chunk
                    clean_text = ansi_cleaner.sub('', buf.decode('utf-8', errors='ignore'))
                    if prompt_re.search(buf) or prompt_re.search(clean_text.encode('utf-8')) or GENERIC_PROMPT_REGEX.search(buf):
                        time.sleep(1)
                        self.log(f"Prompt detected! Read-Only session to {self.cluster.upper()} ready.")
                        return True
                except OSError:
                    break
        self.log(f"Timed out waiting for prompt. Buffer was:\n{buf.decode('utf-8', errors='replace')}")
        if self.proc_pid:
            try:
                os.kill(self.proc_pid, signal.SIGTERM)
            except Exception:
                pass
        return False

    def exec_raw_remote(self, cmd, idle_timeout=60):
        """
        Internal executor for fixed read-only command templates.
        Uses unique markers and idle timeout recovery.
        """
        with self.cmd_lock:
            self.current_cmd = cmd
            self.current_cmd_start = time.time()

            # Drain any stale pending output
            while True:
                r, _, _ = select.select([self.master], [], [], 0.05)
                if self.master in r:
                    try:
                        chunk = os.read(self.master, 4096)
                        if not chunk:
                            break
                    except OSError:
                        break
                else:
                    break

            req_id = uuid.uuid4().hex[:8]
            start_marker = f"__HPC_RO_START_{req_id}__"
            end_marker = f"__HPC_RO_END_{req_id}__"

            full_cmd = f"echo __HPC_RO_START_\"\"{req_id}__; ({cmd}); echo __HPC_RO_END_\"\"{req_id}__ $?\n"
            try:
                os.write(self.master, full_cmd.encode('utf-8'))
            except OSError as e:
                self.current_cmd = None
                self.log(f"PTY write error on {self.cluster}: {e}. Session disconnected.")
                self.running = False
                try:
                    if os.path.exists(self.sock_path):
                        os.remove(self.sock_path)
                except Exception:
                    pass
                return 1, f"Remote session on {self.cluster} disconnected ({e}). Run 'hpc-run --start {self.cluster}' to reconnect."

            raw = b''
            last_io_time = time.time()
            start_found = False
            exit_code = 0

            while True:
                now = time.time()
                if now - last_io_time > idle_timeout:
                    self.log(f"Operation timed out after {idle_timeout}s: {cmd[:60]}")
                    try:
                        os.write(self.master, b'\x03\n')
                    except Exception:
                        pass
                    self.current_cmd = None
                    return 124, f"Operation timed out: no output activity for {idle_timeout}s on {self.cluster}."

                r, _, _ = select.select([self.master], [], [], 0.2)
                if self.master in r:
                    try:
                        chunk = os.read(self.master, 65536)
                        if not chunk:
                            break
                        raw += chunk
                        last_io_time = time.time()
                    except OSError:
                        break

                text = raw.decode('utf-8', errors='replace')
                if not start_found:
                    idx = text.find(start_marker)
                    if idx != -1:
                        start_found = True
                        nl = text.find('\n', idx)
                        if nl != -1:
                            raw = text[nl + 1:].encode('utf-8')
                        else:
                            raw = text[idx + len(start_marker):].encode('utf-8')

                if start_found:
                    text_curr = raw.decode('utf-8', errors='replace')
                    idx_end = text_curr.find(end_marker)
                    if idx_end != -1:
                        output = text_curr[:idx_end].strip('\r\n')
                        after = text_curr[idx_end + len(end_marker):].strip()
                        parts = after.split()
                        if parts:
                            try:
                                exit_code = int(parts[0])
                            except ValueError:
                                exit_code = 0
                        self.current_cmd = None
                        return exit_code, output

        self.current_cmd = None
        return 1, "Connection closed unexpectedly."

    def execute_readonly_handler(self, op, path):
        """
        P0-3: Daemon-level rigid read-only handlers.
        Only generates predefined remote commands with '--' option terminators.
        """
        ok, safe_path = sanitize_remote_path(path)
        if not ok:
            return 13, f"READ_ONLY_OPERATION_DENIED: Invalid path ({safe_path})"

        quoted = shlex.quote(safe_path)

        if op == "list":
            # List remote directory entries (non-recursive, single layer)
            cmd = f'if [ -d -- {quoted} ]; then /bin/ls -1 -p -- {quoted}; exit 0; else echo "NOT_A_DIRECTORY"; exit 1; fi'
            return self.exec_raw_remote(cmd, idle_timeout=30)

        elif op == "stat":
            # Query remote file size, mtime, and file type attributes
            cmd = f'if [ -e -- {quoted} ]; then stat -c "%s %Y %f" -- {quoted} 2>/dev/null || stat -f "%z %m %p" -- {quoted} 2>/dev/null; exit 0; else echo "NOT_FOUND"; exit 1; fi'
            return self.exec_raw_remote(cmd, idle_timeout=15)

        elif op == "download":
            # P1-7: Check remote file exists and enforce 50MB maximum file size before Base64 retrieval
            cmd = (
                f'if [ -f -- {quoted} ]; then '
                f'sz=$(stat -c "%s" -- {quoted} 2>/dev/null || stat -f "%z" -- {quoted} 2>/dev/null || echo 0); '
                f'if [ "$sz" -le {MAX_DOWNLOAD_BYTES} ]; then '
                f'(base64 -w 0 -- {quoted} 2>/dev/null || base64 -b 0 -- {quoted} 2>/dev/null || base64 -- {quoted} | tr -d "\\r\\n"); exit 0; '
                f'else echo "ERR_FILE_TOO_LARGE"; exit 2; fi; '
                f'else echo "ERR_FILE_NOT_FOUND"; exit 1; fi'
            )
            return self.exec_raw_remote(cmd, idle_timeout=60)

        return 13, f"READ_ONLY_OPERATION_DENIED: Unknown operation '{op}'"

    def handle_client(self, conn):
        """
        Processes client requests over Unix Domain Socket.
        P0-1 & P0-3: Default-Deny. Unknown or raw requests are strictly rejected.
        P1-5: Verifies peer UID.
        """
        try:
            if not verify_peer_uid(conn):
                self.log("SECURITY ALERT: Rejected connection from unverified local UID.")
                conn.sendall(b"13\nREAD_ONLY_OPERATION_DENIED: Unauthorized local process UID.\n")
                return

            data = b''
            while True:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
                if b'\n' in data:
                    break

            raw_str = data.decode('utf-8', errors='ignore').strip()
            if not raw_str:
                return

            # Strict structured JSON RPC parsing
            try:
                req = json.loads(raw_str)
            except Exception:
                # P0-1: Raw shell string injection attempt blocked
                self.log(f"SECURITY ALERT: Blocked unformatted raw payload attempt: {raw_str[:60]}")
                conn.sendall(b"13\nREAD_ONLY_OPERATION_DENIED: Arbitrary command strings prohibited.\n")
                return

            op = str(req.get("op", "")).lower().strip()
            proto = req.get("protocol")

            if proto != PROTOCOL_VERSION:
                self.log(f"SECURITY ALERT: Protocol version mismatch: {proto}")
                conn.sendall(f"13\nREAD_ONLY_OPERATION_DENIED: Protocol mismatch (expected {PROTOCOL_VERSION}).\n".encode())
                return

            # Control operations
            if op == "ping":
                conn.sendall(f"0\nPONG IDLE [{PROTOCOL_VERSION}]\n".encode())
                return
            elif op == "status":
                status_str = f"ONLINE (IDLE) [READ_ONLY, {PROTOCOL_VERSION}]"
                conn.sendall(f"0\n{status_str}\n".encode())
                return
            elif op == "stop":
                conn.sendall(b"0\nSTOPPING\n")
                self.running = False
                return

            # P0-3: Enforce Default-Deny capability whitelist
            if op not in ALLOWED_REMOTE_OPS:
                self.log(f"SECURITY ALERT: Denied non-whitelisted operation '{op}'.")
                conn.sendall(f"13\nREAD_ONLY_OPERATION_DENIED: Operation '{op}' is prohibited in read-only mode.\n".encode())
                return

            path = req.get("path", "")
            self.log(f"Executing Read-Only Op: {op} on {path[:80]}")
            code, out = self.execute_readonly_handler(op, path)

            resp = f"{code}\n{out}\n"
            conn.sendall(resp.encode('utf-8'))

        except Exception as e:
            self.log(f"Connection handler exception: {e}")
        finally:
            try:
                conn.close()
            except Exception:
                pass

    def run_server(self):
        """Run Unix domain socket server with strict 0600 permissions."""
        if os.path.exists(self.sock_path):
            try:
                os.remove(self.sock_path)
            except Exception:
                pass

        self.log_fp = open(self.log_path, "a")
        self.log(f"Read-Only Daemon starting for {self.cluster} (PID={os.getpid()}, Version={PROTOCOL_VERSION})...")

        with open(self.pid_path, "w") as f:
            f.write(str(os.getpid()))
        try:
            os.chmod(self.pid_path, 0o600)
        except Exception:
            pass

        if not self.master:
            if not self.start_ssh_session_headless():
                self.log(f"Failed to initialize session for {self.cluster}. Exiting.")
                self.cleanup()
                return

        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(self.sock_path)
        try:
            os.chmod(self.sock_path, 0o600)
        except Exception:
            pass

        server.listen(20)
        server.settimeout(1.0)
        self.log(f"Listening on protected read-only socket: {self.sock_path} (mode 0600)")

        while self.running:
            try:
                conn, _ = server.accept()
            except socket.timeout:
                if self.proc_pid:
                    try:
                        os.kill(self.proc_pid, 0)
                    except OSError:
                        self.log("Child SSH process exited. Attempting headless restart...")
                        self.proc_pid = None
                        if not self.start_ssh_session_headless():
                            self.log("Headless restart failed. Exiting daemon cleanly.")
                            self.running = False
                            break
                continue
            except Exception as e:
                self.log(f"Accept error: {e}")
                time.sleep(0.5)
                continue

            client_thread = threading.Thread(target=self.handle_client, args=(conn,), daemon=True)
            client_thread.start()

        self.cleanup()

    def cleanup(self):
        self.log("Stopping read-only daemon and cleaning up resources...")
        if self.master:
            try:
                os.write(self.master, b"exit\n")
                time.sleep(0.3)
                os.close(self.master)
            except Exception:
                pass
        for f in (self.sock_path, self.pid_path):
            if os.path.exists(f):
                try:
                    os.remove(f)
                except Exception:
                    pass
        if self.log_fp:
            try:
                self.log_fp.close()
            except Exception:
                pass


def client_send(cluster, op, path="", timeout=None):
    """
    Sends structured JSON read-only request to cluster daemon over protected Unix Domain Socket.
    """
    sock_path, pid_path, _ = get_paths(cluster)
    if not os.path.exists(sock_path):
        return None, f"Read-only daemon for {cluster} is not running."

    is_control = op in ALLOWED_CONTROL_OPS
    if timeout is None:
        timeout = 3.0 if is_control else 65.0

    req_data = {
        "op": op,
        "path": path,
        "protocol": PROTOCOL_VERSION
    }
    payload = json.dumps(req_data) + "\n"

    s = None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(sock_path)
        s.sendall(payload.encode('utf-8'))

        resp = b''
        while True:
            try:
                s.settimeout(timeout)
                chunk = s.recv(65536)
                if not chunk:
                    break
                resp += chunk
                # P1-7: Prevent unbounded memory reading on download responses
                if len(resp) > MAX_DOWNLOAD_BYTES * 2:
                    return 2, "Response size exceeded maximum allowable bound."
            except socket.timeout:
                if is_control:
                    return None, f"Control request timed out ({timeout}s)"
                return 124, f"Socket timeout ({timeout}s) while awaiting response from {cluster}."

        text = resp.decode('utf-8', errors='replace')
        first_nl = text.find('\n')
        if first_nl != -1:
            code_str = text[:first_nl].strip()
            out = text[first_nl + 1:].rstrip('\n')
            try:
                return int(code_str), out
            except ValueError:
                return 0, text
        return 0, text

    except Exception as e:
        return None, str(e)
    finally:
        if s:
            try:
                s.close()
            except Exception:
                pass


def ensure_daemon_running(cluster):
    check_legacy_daemon(cluster)

    code, resp = client_send(cluster, "ping", timeout=2.0)
    if resp and "PONG" in resp:
        return True

    if os.environ.get("HPC_NON_INTERACTIVE") == "1" or not sys.stdin.isatty():
        sys.stderr.write(f"[{cluster.upper()}] Cluster is offline and non-interactive mode is active. Run 'hpc-run --start {cluster}' to connect.\n")
        return False

    sys.stderr.write(f"[{cluster.upper()}] Starting background read-only session...\n")
    if start_daemon_headless_background(cluster):
        sys.stderr.write(f"[{cluster.upper()}] Read-only session ready.\n")
        return True

    return start_daemon_interactive(cluster)


def start_daemon_headless_background(cluster):
    sock_path, pid_path, _ = get_paths(cluster)
    cfg = CLUSTERS[cluster]
    timeout_init = cfg["timeout_init"]

    pid = os.fork()
    if pid == 0:
        os.setsid()
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0)
        os.dup2(devnull, 1)
        os.dup2(devnull, 2)
        os.close(devnull)
        d_pid = os.fork()
        if d_pid == 0:
            daemon = HPCDaemon(cluster)
            daemon.run_server()
        os._exit(0)

    t0 = time.time()
    while time.time() - t0 < timeout_init + 5:
        if os.path.exists(sock_path):
            code, resp = client_send(cluster, "ping", timeout=2.0)
            if resp and "PONG" in resp:
                return True
        if os.path.exists(pid_path):
            try:
                with open(pid_path) as f:
                    daemon_pid = int(f.read().strip())
                os.kill(daemon_pid, 0)
            except OSError:
                return False
        time.sleep(0.5)
    return False


def start_daemon_interactive(cluster):
    sock_path, pid_path, _ = get_paths(cluster)
    if os.path.exists(pid_path):
        try:
            with open(pid_path) as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            print(f"[{cluster.upper()}] Read-only daemon is already running (PID={pid}).")
            return True
        except OSError:
            pass

    cfg = CLUSTERS[cluster]
    is_interactive = sys.stdin.isatty() and sys.stdout.isatty()

    if not is_interactive:
        print(f"[{cluster.upper()}] Error: Daemon is offline and requires interactive PIN/YubiKey verification.")
        print(f"Please run 'hpc-run --start {cluster}' in an interactive terminal first.")
        return False

    cluster_env = cluster.upper().replace('-', '_')
    user = resolve_ssh_user(cluster)
    if is_interactive:
        prompt_txt = f"Enter your HPC username for [{cluster.upper()}]"
        if user:
            prompt_txt += f" [{user}]"
        prompt_txt += ": "
        try:
            val = input(prompt_txt).strip()
            if val:
                user = val
            if user:
                os.environ[f"HPC_{cluster_env}_USER"] = user
                os.environ["HPC_USER"] = user
                try:
                    with open(os.path.expanduser(f"~/.hpc_user_{cluster}"), "w") as f:
                        f.write(user + "\n")
                    with open(os.path.expanduser("~/.hpc_user"), "w") as f:
                        f.write(user + "\n")
                except Exception:
                    pass
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            return False

    ssh_cmd = get_ssh_cmd(cluster)
    prompt_re = cfg["prompt_regex"]

    print(f"\n========================================================")
    print(f"  Starting persistent read-only session for [{cluster.upper()}] ({cfg['description']})")
    print(f"  Please enter your PIN and touch your YubiKey if prompted.")
    print(f"========================================================\n")

    child_pid, master_fd = pty.fork()
    if child_pid == 0:
        os.execvp('ssh', ssh_cmd)

    try:
        import fcntl
        winsize = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b'\0' * 8)
        fcntl.ioctl(master_fd, termios.TIOCSWINSZ, winsize)
    except Exception:
        pass

    old_term = termios.tcgetattr(sys.stdin.fileno())
    buf = b''
    start_time = time.time()
    authenticated = False
    ansi_cleaner = re.compile(r'\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])|\x1b\][^\x07\x1b]*[\x07\x1b\\]')
    max_timeout = 120

    try:
        tty.setraw(sys.stdin.fileno())
        while time.time() - start_time < max_timeout:
            r, _, _ = select.select([master_fd, sys.stdin.fileno()], [], [], 0.02)
            if master_fd in r:
                try:
                    chunk = os.read(master_fd, 4096)
                    if not chunk:
                        break
                    buf += chunk
                    os.write(sys.stdout.fileno(), chunk)

                    clean_text = ansi_cleaner.sub('', buf.decode('utf-8', errors='ignore'))
                    if 'Last login:' in clean_text and time.time() - start_time > 30:
                        start_time = time.time() - 30

                    if prompt_re.search(buf) or GENERIC_PROMPT_REGEX.search(buf) or re.search(r'\[.+@.+\]\s*[$#]|[@:][\w\.\-]+[^\n\r]*[$#>]\s*$', clean_text):
                        time.sleep(0.3)
                        authenticated = True
                        break
                except OSError:
                    break

            if sys.stdin.fileno() in r:
                try:
                    user_input = os.read(sys.stdin.fileno(), 1024)
                    if not user_input:
                        break
                    os.write(master_fd, user_input)
                    start_time = time.time()
                except OSError:
                    break

            wpid, status = os.waitpid(child_pid, os.WNOHANG)
            if wpid != 0:
                break
    finally:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_term)

    if not authenticated:
        print(f"\n[{cluster.upper()}] Authentication failed or cancelled. Exiting.")
        try:
            os.kill(child_pid, signal.SIGTERM)
        except Exception:
            pass
        os.close(master_fd)
        return False

    print(f"\n\n[{cluster.upper()}] >>> Prompt detected! Authentication successful! <<<")
    print(f"[{cluster.upper()}] Daemonizing read-only session into background...")

    pid = os.fork()
    if pid == 0:
        os.setsid()
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0)
        os.dup2(devnull, 1)
        os.dup2(devnull, 2)
        os.close(devnull)
        d_pid = os.fork()
        if d_pid == 0:
            daemon = HPCDaemon(cluster, master_fd=master_fd, child_pid=child_pid)
            daemon.run_server()
        os._exit(0)

    t0 = time.time()
    while time.time() - t0 < 10:
        if os.path.exists(sock_path):
            code, resp = client_send(cluster, "ping", timeout=2.0)
            if resp and "PONG" in resp:
                print(f"[{cluster.upper()}] Read-only session is now LIVE and READY in background!")
                print(f"[{cluster.upper()}] Subsequent reads will execute in 0.1s without PIN/YubiKey.\n")
                return True
        time.sleep(0.5)

    print(f"[{cluster.upper()}] Error: Timed out waiting for read-only daemon socket.")
    return False


def stop_daemon(cluster):
    sock_path, pid_path, _ = get_paths(cluster)
    if not os.path.exists(pid_path):
        print(f"[{cluster.upper()}] Read-only daemon is not running.")
        return
    try:
        client_send(cluster, "stop", timeout=2.0)
        time.sleep(0.5)
    except Exception:
        pass
    if os.path.exists(pid_path):
        try:
            with open(pid_path) as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
            time.sleep(0.2)
            os.kill(pid, signal.SIGKILL)
            print(f"[{cluster.upper()}] Stopped read-only daemon (PID={pid}).")
        except Exception as e:
            print(f"[{cluster.upper()}] Stopped read-only daemon.")
    for p in (sock_path, pid_path):
        if os.path.exists(p):
            try:
                os.remove(p)
            except Exception:
                pass


def check_status(cluster):
    sock_path, pid_path, _ = get_paths(cluster)
    if not os.path.exists(sock_path):
        return False, "OFFLINE"
    code, resp = client_send(cluster, "status", timeout=2.0)
    if resp and "ONLINE" in resp:
        return True, resp.strip()
    return False, "OFFLINE"


def safe_atomic_download_write(data_b64, local_path):
    """
    P1-7: Safely decodes Base64 data and writes to local_path using an atomic temp file.
    Rejects or removes symlinks to prevent symlink overwrite attacks.
    """
    try:
        raw_bytes = base64.b64decode(data_b64.strip())
    except Exception as e:
        return False, f"Base64 decode failure: {e}"

    if len(raw_bytes) > MAX_DOWNLOAD_BYTES:
        return False, f"Decoded payload exceeds {MAX_DOWNLOAD_BYTES} bytes."

    local_path = os.path.abspath(local_path)
    dir_name = os.path.dirname(local_path)
    os.makedirs(dir_name, exist_ok=True)

    # Disallow writing through symbolic links
    if os.path.islink(local_path):
        try:
            os.unlink(local_path)
        except Exception:
            pass

    tmp_file = os.path.join(dir_name, f".tmp_dl_{os.getpid()}_{uuid.uuid4().hex[:6]}")
    try:
        with open(tmp_file, "wb") as f:
            f.write(raw_bytes)
        os.replace(tmp_file, local_path)
        return True, len(raw_bytes)
    except Exception as e:
        if os.path.exists(tmp_file):
            try:
                os.remove(tmp_file)
            except Exception:
                pass
        return False, str(e)


def print_help():
    print("hpc-run: Hardened Read-Only Multi-Cluster SSH Access Tool for NOAA HPC (V1)")
    print(f"Protocol: {PROTOCOL_VERSION} (Application-Level Strict Read-Only)")
    print("\nSupported clusters:")
    for c, info in CLUSTERS.items():
        online, status = check_status(c)
        mark = "●" if online else "○"
        print(f"  {mark} {c:<10} - {info['description']} [{status}]")

    print("\nPermitted Structured Read-Only Operations (V1):")
    print("  hpc-run <cluster> list <remote_dir>")
    print("      List remote directory entries (non-recursive)")
    print("  hpc-run <cluster> stat <remote_path>")
    print("      Query remote file size and metadata")
    print("  hpc-run <cluster> download <remote_path> <local_path>")
    print("      Download single remote file safely to local path (Max 50 MB)")

    print("\nConnection Management:")
    print("  hpc-run --list                       List all supported clusters and live status")
    print("  hpc-run --status [cluster|all]       Check daemon status")
    print("  hpc-run --start <cluster>            Authenticate (PIN + YubiKey) and start read-only daemon")
    print("  hpc-run --stop [cluster|all]         Stop background session daemon")

    print("\nSecurity Boundary:")
    print("  Arbitrary remote command execution, upload, delete, file modification,")
    print("  and job submission are permanently disabled by the background daemon.")


def main():
    args = sys.argv[1:]
    if not args:
        print_help()
        sys.exit(0)

    # Global flags
    if args[0] in ["--help", "-h"]:
        print_help()
        sys.exit(0)

    if args[0] == "--list":
        print_help()
        sys.exit(0)

    if args[0] == "--status":
        raw_target = args[1].lower() if len(args) > 1 else "all"
        if raw_target == "all":
            for c in CLUSTERS:
                _, status = check_status(c)
                print(f"{c:<10}: {status}")
        elif raw_target == "gaea":
            for c in GAEA_CLUSTERS:
                _, status = check_status(c)
                print(f"{c:<10}: {status}")
        else:
            target = CLUSTER_ALIASES.get(raw_target, raw_target)
            if target not in CLUSTERS:
                print(f"Unknown cluster: {raw_target}. Available: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}")
                sys.exit(1)
            _, status = check_status(target)
            print(f"{target}: {status}")
        sys.exit(0)

    if args[0] == "--start":
        raw_target = args[1].lower() if len(args) > 1 else None
        if not raw_target or raw_target == "all":
            print("Please specify a cluster to start (e.g. hpc-run --start gaea-c6)")
            print(f"Available: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}")
            sys.exit(1)
        if raw_target == "gaea":
            target = "gaea-c5"
            print("[GAEA] Generic 'gaea' defaults to gaea-c5. (Use --start gaea-c6 or gaea-c7 for C6/C7).")
        else:
            target = CLUSTER_ALIASES.get(raw_target, raw_target)
        if target not in CLUSTERS:
            print(f"Unknown cluster: {raw_target}.")
            sys.exit(1)
        ok = start_daemon_interactive(target)
        sys.exit(0 if ok else 1)

    if args[0] == "--stop":
        raw_target = args[1].lower() if len(args) > 1 else "all"
        if raw_target == "all":
            for c in CLUSTERS:
                stop_daemon(c)
        elif raw_target == "gaea":
            for c in GAEA_CLUSTERS:
                stop_daemon(c)
        else:
            target = CLUSTER_ALIASES.get(raw_target, raw_target)
            if target not in CLUSTERS:
                print(f"Unknown cluster: {raw_target}.")
                sys.exit(1)
            stop_daemon(target)
        sys.exit(0)

    # Target cluster resolution
    raw_cluster = args[0].lower()
    if raw_cluster in CLUSTERS:
        cluster = raw_cluster
    elif raw_cluster in CLUSTER_ALIASES:
        cluster = CLUSTER_ALIASES[raw_cluster]
    elif raw_cluster == "gaea":
        cluster = resolve_default_gaea_cluster()
    else:
        print(f"Error: Unknown cluster or option '{raw_cluster}'.", file=sys.stderr)
        print(f"Available clusters: {', '.join(list(CLUSTERS.keys()) + ['gaea'])}", file=sys.stderr)
        print("Run 'hpc-run --help' for usage.", file=sys.stderr)
        sys.exit(1)

    sub_args = args[1:]
    if not sub_args:
        print(f"Error: Missing read-only operation for cluster '{cluster}'.", file=sys.stderr)
        print("Allowed operations: list, stat, download", file=sys.stderr)
        sys.exit(1)

    op = sub_args[0].lower().strip()

    # P0-1: STRICT READ-ONLY ENFORCEMENT & DEFAULT-DENY
    if op not in ALLOWED_REMOTE_OPS:
        sys.stderr.write(f"\n[SECURITY BLOCKED] Arbitrary shell command execution is permanently disabled.\n")
        sys.stderr.write(f"Attempted operation: {op}\n")
        sys.stderr.write(f"Permitted read-only operations:\n")
        sys.stderr.write(f"  hpc-run {cluster} list <remote_dir>\n")
        sys.stderr.write(f"  hpc-run {cluster} stat <remote_path>\n")
        sys.stderr.write(f"  hpc-run {cluster} download <remote_path> <local_path>\n")
        sys.stderr.write(f"\nError: READ_ONLY_OPERATION_DENIED\n")
        sys.exit(13)

    # Validate argument count prior to starting daemon
    if op in {"list", "stat"} and len(sub_args) < 2:
        print(f"Error: '{op}' requires a remote path argument.", file=sys.stderr)
        sys.exit(1)
    elif op == "download" and len(sub_args) < 3:
        print("Error: 'download' requires <remote_path> and <local_path> arguments.", file=sys.stderr)
        sys.exit(1)

    # Ensure daemon is running
    ok = ensure_daemon_running(cluster)
    if not ok:
        sys.exit(1)

    remote_path = sub_args[1]

    if op == "list":
        code, out = client_send(cluster, "list", path=remote_path)
        if code == 0:
            print(out)
            sys.exit(0)
        else:
            print(f"Error: {out}", file=sys.stderr)
            sys.exit(code or 1)

    elif op == "stat":
        code, out = client_send(cluster, "stat", path=remote_path)
        if code == 0:
            print(out)
            sys.exit(0)
        else:
            print(f"Error: {out}", file=sys.stderr)
            sys.exit(code or 1)

    elif op == "download":
        local_path = sub_args[2]
        code, out = client_send(cluster, "download", path=remote_path)
        if code != 0:
            print(f"Download failed: {out}", file=sys.stderr)
            sys.exit(code or 1)

        ok, msg = safe_atomic_download_write(out, local_path)
        if ok:
            print(f"Successfully downloaded {remote_path} to {local_path} ({msg} bytes).")
            sys.exit(0)
        else:
            print(f"Failed to save local file: {msg}", file=sys.stderr)
            sys.exit(1)


if __name__ == '__main__':
    main()
